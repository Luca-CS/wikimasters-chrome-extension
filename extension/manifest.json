{
  "manifest_version": 3,
  "name": "WikiMasters Tagger",
  "version": "0.1.0",
  "description": "Analyse ta collection WikiMasters, propose des étiquettes et surligne les cartes à étiqueter. N'étiquette jamais rien toute seule.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WikiMasters Tagger",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.wikidata.org/*"],
  "content_scripts": [
    {
      "matches": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"],
      "js": ["lib/core.js", "lib/defaults.js", "lib/store.js", "lib/dom.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
